{
  "ConnectionStrings": {
    "Default": "Server=YOUR_SQL_SERVER;Database=FleetPilot;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Jwt": {
    "Issuer": "FleetPilot",
    "Audience": "FleetPilot.App",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "SeedAdmin": {
    "Name": "Administrator",
    "Email": "",
    "Password": ""
  },
  "Company": {
    "Name": "Fleet Pilot",
    "TimeZone": "Asia/Dubai"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "App_Data/photos",
    "AzureConnectionString": "",
    "AzureContainer": "odometer-photos",
    "MaxPhotoBytes": 8388608
  },
  "Ocr": {
    "Provider": "None",
    "AzureEndpoint": "",
    "AzureKey": ""
  },
  "OdometerRules": {
    "MinOcrConfidence": 0.8,
    "MaxKmPerShift": 1000,
    "MaxGapBetweenShiftsKm": 50,
    "ServerOcrToleranceKm": 0,
    "MaxOfflineAgeHours": 72
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "Origins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/fleetpilot-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 }
      }
    ]
  },
  "AllowedHosts": "*"
}
