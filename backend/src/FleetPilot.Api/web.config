<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings. "dotnet publish" fills in processPath/arguments for the published app.
  ASP.NET Core 8 Hosting Bundle must be installed on the server.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Set stdoutLogEnabled="true" temporarily if the site fails to start (writes to .\logs\stdout_*.log). -->
      <aspNetCore processPath="dotnet" arguments=".\FleetPilot.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 12 MB, enough for an odometer photo upload. -->
          <requestLimits maxAllowedContentLength="12582912" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
